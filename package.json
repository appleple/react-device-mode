{
  "name": "react-device-mode",
  "version": "1.5.0",
  "description": "device viewer for a-blog cms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appleple/react-device-mode.git"
  },
  "browserslist": [
    "defaults",
    "safari >= 12"
  ],
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "concurrently \"tsup --watch --sourcemap inline\" \"vite\"",
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,jsx,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,mjs,cjs,ts,jsx,tsx}\"",
    "test": "echo \"no tests yet\" && exit 0",
    "prepare": "husky",
    "prepack": "npm run build",
    "preversion": "npm run build && npm test",
    "postversion": "git push && git push --tags",
    "release:major": "npm version major",
    "release:minor": "npm version minor",
    "release:patch": "npm version patch"
  },
  "author": "steelydylan",
  "license": "MIT",
  "dependencies": {
    "re-resizable": "^6.9.17"
  },
  "peerDependencies": {
    "react": ">=16.8.0 <20.0.0",
    "react-dom": ">=16.8.0 <20.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.7.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.8.0",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.1.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.16.1",
    "vite": "^8.1.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "eslint": "^9.7.0"
  }
}
